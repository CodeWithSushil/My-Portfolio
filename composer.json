{
    "name": "sushilk/portfolio",
    "description": "Sushil Kumar portfolio",
    "type": "project",
    "keywords": [
        "website",
        "portfolio",
        "Sushil Kumar"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Sushil Kumar",
            "email": "sushilkumbhar77@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "symfony/mailer": "^8.1",
        "vlucas/phpdotenv": "^5.6",
        "egulias/email-validator": "^4.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.30",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/Functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@composer install --prefer-dist --no-interaction --no-progress",
            "@composer dump-autoload --optimize"
        ],
        "serve": "php -S localhost:8000 -t public/",
        "install": "composer install --prefer-dist --no-interaction --no-progress --optimize-autoloader",
        "install:prod": "composer install --prefer-dist --no-dev --no-interaction --no-progress --optimize-autoloader",
        "autoload": "composer dump-autoload --optimize",
        "pint": "pint",
        "pint:test": "pint --test",
        "phpstan": "phpstan analyse",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "quality": [
            "@pint:test",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "process-timeout": 300
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
