# Enable URL rewriting
RewriteEngine On

# Redirect all requests to index.php if file/folder not found
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force non-www (or change to www if you prefer)
RewriteCond %{HTTP_HOST} ^www\.(.+) [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]


# Security: Disable access to hidden files and config
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent access to database directly
<Files "database.db">
    Order allow,deny
    Deny from all
</Files>

# Allow PHP and SQLite
AddType application/x-httpd-php .php
